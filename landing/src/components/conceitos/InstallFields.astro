---
import { INSTALL_CMD, SCRIPT_URL, HELP_URL } from "../../data/conceitos.js";

const {
  fieldId = "install-cmd",
  forceFail = false,
  hideReq = false,
  hideBlurb = false,
  showScriptField = false,
} = Astro.props;
---

<div class="install-fields" data-install-root>
  {!hideReq && (
    <p class="install-req">Para Mac com Apple Silicon e macOS 14 ou mais recente. Requer Xcode e XcodeGen.</p>
  )}
  {!hideBlurb && (
    <p class="install-blurb">O instalador compila o Breve no seu Mac e coloca o app em Aplicativos.</p>
  )}
  <p class="install-nonmac" hidden data-nonmac>A instalação é feita no Mac.</p>
  {showScriptField && (
    <p class="install-script">
      <label class="install-label" for={`${fieldId}-script`}>URL do script</label>
      <input
        class="install-script-url"
        id={`${fieldId}-script`}
        type="text"
        readonly
        value={SCRIPT_URL}
        spellcheck="false"
      />
    </p>
  )}
  <label class="install-label" for={fieldId}>Comando de instalação</label>
  <textarea
    id={fieldId}
    class="install-cmd"
    data-install-cmd
    data-dialog-focus
    readonly
    rows="2"
    spellcheck="false">{INSTALL_CMD}</textarea>
  <div class="install-copy-row">
    <button
      type="button"
      class="install-copy"
      data-copy
      data-force-fail={forceFail ? true : undefined}
      aria-label="Copiar comando">Copiar comando</button>
    <p class="install-status" role="status" aria-live="polite" data-copy-status></p>
  </div>
  <p class="install-steps">Copie o comando, cole no Terminal e, depois de instalar, pesquise Breve no Mac.</p>
  <p class="install-links">
    <a href={SCRIPT_URL} target="_blank" rel="noreferrer">Ver o script</a>
    <a href={HELP_URL} target="_blank" rel="noreferrer">Ajuda para instalar</a>
  </p>
</div>
