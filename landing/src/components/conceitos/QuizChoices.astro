---
const { quiz, compact = false } = Astro.props;
---

<div class:list={["quiz-choices", compact && "quiz-choices-compact"]}>
  {quiz.options.map((opt, i) => (
    <button
      class="quiz-opt"
      type="button"
      data-option
      data-correct={i === quiz.correct ? "true" : "false"}
    >
      {opt}
    </button>
  ))}
  <p class="quiz-explain" data-explain hidden>
    <strong>Por quê.</strong> {quiz.explanation}
  </p>
</div>
