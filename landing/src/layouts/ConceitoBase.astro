---
import { getImage } from "astro:assets";
import mascot from "../../../assets/bonequinho.png";
import "@fontsource/besley/latin-400.css";
import "@fontsource/besley/latin-600.css";
import "@fontsource/geist/latin-400.css";
import "@fontsource/geist/latin-500.css";
import "@fontsource/geist/latin-600.css";

const favicon = await getImage({ src: mascot, width: 48, format: "png" });
const { title, theme, surface, ink } = Astro.props;
const bodyTone = [surface && `background:${surface}`, ink && `color:${ink}`].filter(Boolean).join(";");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={theme || "#F7F4EE"} />
    <title>{title}</title>
    <link rel="icon" href={favicon.src} type="image/png" />
  </head>
  <body style={bodyTone || undefined}>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html { overflow-x: auto; }
      img { max-width: 100%; height: auto; }
      a { color: inherit; }
      .github {
        text-decoration: underline;
        text-underline-offset: 0.22em;
        text-decoration-thickness: 1.5px;
        font-weight: 600;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .skip {
        position: absolute; left: 12px; top: -80px; padding: 10px 16px;
        background: #111; color: #fff; z-index: 40; text-decoration: none;
      }
      .skip:focus { top: 10px; }
    </style>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
