---
import ConceitoBase from "../../layouts/ConceitoBase.astro";
import { Image } from "astro:assets";
import ReviewBar from "../../components/conceitos/ReviewBar.astro";
import MacDesk from "../../components/conceitos/MacDesk.astro";
import InstallFields from "../../components/conceitos/InstallFields.astro";
import QuizChoices from "../../components/conceitos/QuizChoices.astro";
import { NOTE, QUIZ } from "../../data/conceitos.js";
import icon from "../../../../macos/Assets.xcassets/AppIcon.appiconset/icon_256.png";
---

<ConceitoBase title="Uma pausa. Uma ideia nova. · Breve" theme="#F7F4EE">
  <style is:global>
    @import "../../styles/conceitos/desk.css";
    :root { --paper:#F7F4EE; --ink:#222420; --accent:#E87942; --cta:#B4451A; --link:#8E3A14; --muted:#5c605a; }
    body { margin:0; background:var(--paper); color:var(--ink); font-family:Geist,sans-serif; font-size:16px; line-height:1.55; }
    button { cursor:pointer; font:inherit; }
    .p1-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; width:min(1200px, calc(100% - 48px)); margin:0 auto; padding:22px 0; }
    .p1-brand { display:flex; gap:10px; align-items:center; font-weight:600; text-decoration:none; color:inherit; min-height:44px; }
    .p1-nav { display:flex; gap:12px; align-items:center; flex-wrap:wrap; }
    .p1-nav a { color:var(--muted); text-decoration:none; min-height:44px; display:inline-flex; align-items:center; }
    .p1-nav .github { color:var(--link); }
    .p1-cta, .p1-ghost { min-height:44px; padding:0 18px; border-radius:999px; border:1px solid transparent; }
    .p1-cta { background:var(--cta); color:#fff; }
    .p1-ghost { background:transparent; border-color:#22242033; }
    .p1-hero { display:grid; gap:36px; width:min(1200px, calc(100% - 48px)); margin: 12px auto 48px; align-items:center; }
    @media (min-width: 960px) { .p1-hero { grid-template-columns: 5fr 7fr; min-height: 72vh; } }
    .p1-hero h1 { font-family:Besley,Georgia,serif; font-size:clamp(40px, 5.4vw, 88px); line-height:1.08; font-weight:600; margin:0 0 16px; }
    .p1-hero .lead { font-family:Besley,Georgia,serif; font-size:clamp(18px, 2vw, 22px); color:var(--muted); margin:0 0 24px; max-width:28ch; }
    .p1-actions { display:flex; flex-wrap:wrap; gap:12px; }
    .p1-sign { margin:18px 0 0; color:var(--muted); font-size:14px; }
    .p1-desk .study-card { background:#fffdf8; border:1px solid #22242018; border-radius:14px; box-shadow: 8px 18px 40px #22242014; font-family:Besley,Georgia,serif; }
    .p1-desk .meta { font-family:Geist,sans-serif; font-size:12px; color:var(--muted); display:flex; gap:8px; margin-bottom:8px; }
    .p1-desk .study-card h2 { font-size:18px; margin:0 0 8px; }
    .quiz-opt { display:block; width:100%; text-align:left; margin:6px 0; padding:10px 12px; min-height:44px; border:1px solid #22242022; background:#fff; font: 16px Geist,sans-serif; border-radius:8px; color:var(--ink); -webkit-text-fill-color: var(--ink); }
    .quiz-opt[aria-disabled="true"] { opacity:1; color:var(--ink); -webkit-text-fill-color: var(--ink); cursor:default; }
    .quiz-opt[aria-pressed="true"] { border-color: var(--ink); }
    .quiz-opt[data-reveal="correct"] { border:2px solid var(--cta); background:#fff8f3; font-weight:600; color:var(--ink); -webkit-text-fill-color: var(--ink); }
    .quiz-opt[data-reveal="correct"] [data-correct-label] { color:var(--cta); -webkit-text-fill-color: var(--cta); font-family:Geist,sans-serif; font-size:13px; font-weight:600; margin-left:6px; }
    .p1-modes { display:flex; gap:8px; flex-wrap:wrap; margin: 0 auto 28px; width:min(1200px, calc(100% - 48px)); }
    .p1-modes button { min-height:44px; padding:0 16px; border-radius:999px; border:1px solid #22242022; background:#fff0; }
    .p1-modes button[aria-pressed="true"] { background:#222420; color:#F7F4EE; }
    .p1-steps { width:min(800px, calc(100% - 48px)); margin: 0 auto 64px; display:grid; gap:18px; }
    .p1-steps article { padding: 8px 0 18px; border-bottom:1px solid #22242014; font-family:Besley,Georgia,serif; }
    .p1-steps h2 { font-size:22px; margin:0 0 6px; }
    .p1-foot { text-align:center; padding: 40px 24px 80px; }
    dialog.p1-dlg { border:0; border-radius:18px; padding:28px; width:min(460px, calc(100% - 24px)); max-height:calc(100dvh - 16px); overflow:auto; background:#FFFcf7; color:var(--ink); position:relative; }
    dialog.p1-dlg::backdrop { background:#22242055; }
    .p1-dlg h2 { font-family:Besley,Georgia,serif; margin:0 0 12px; }
    .install-label { display:block; font-weight:600; margin: 10px 0 6px; }
    .install-cmd { width:100%; font: 14px ui-monospace,monospace; padding:12px; border-radius:10px; border:1px solid #22242022; background:#fff; resize:none; }
    .install-copy { min-height:44px; min-width: 11.5rem; background:var(--cta); color:#fff; border:0; border-radius:10px; padding:0 16px; }
    .install-copy-row { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin:10px 0; }
    .install-links { display:flex; gap:16px; flex-wrap:wrap; }
    .install-links a { color:var(--link); min-height:44px; display:inline-flex; align-items:center; }
    .p1-close { position:absolute; top:12px; right:12px; min-width:44px; min-height:44px; border:0; background:transparent; font-size:22px; }
    a:focus-visible, button:focus-visible, textarea:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
    @media (max-width: 700px) {
      .p1-hero { width: min(1200px, calc(100% - 32px)); }
      .p1-hero h1 { font-size: clamp(40px, 11vw, 48px); }
      .p1-nav [data-try] { display: none; }
      dialog.p1-dlg { width: calc(100% - 8px); max-height: calc(100% - 8px); height: calc(100% - 8px); overflow: auto; border-radius: 12px; }
    }
  </style>

  <ReviewBar n={1} />
  <header class="p1-header">
    <a class="p1-brand" href="#conteudo">
      <Image src={icon} alt="" width={28} height={28} />
      Breve
    </a>
    <nav class="p1-nav" aria-label="Principal">
      <a class="github" href="https://github.com/xinnaider/breve">GitHub</a>
      <button class="p1-ghost" type="button" data-try>Experimentar uma nota</button>
      <button class="p1-cta" type="button" data-open-install>Instalar no Mac</button>
    </nav>
  </header>

  <main id="conteudo" data-study>
    <section class="p1-hero">
      <div>
        <h1>Uma pausa. Uma ideia nova.</h1>
        <p class="lead">Notas curtas e perguntas no canto do Mac. Escolha seus temas e aprenda um pouco por vez.</p>
        <div class="p1-actions">
          <button class="p1-cta" type="button" data-open-install>Instalar no Mac</button>
          <button class="p1-ghost" type="button" data-try>Experimentar uma nota</button>
        </div>
        <p class="p1-sign">Feito para o Mac. Open source.</p>
      </div>
      <div class="p1-desk">
        <MacDesk>
          <article class="study-card" data-note>
            <p class="meta"><span>{NOTE.topic}</span><span>{NOTE.kind}</span></p>
            <h2>{NOTE.title}</h2>
            <p>{NOTE.body}</p>
          </article>
          <article class="study-card" data-quiz hidden>
            <p class="meta"><span>{QUIZ.topic}</span><span>{QUIZ.kind}</span></p>
            <h2>{QUIZ.title}</h2>
            <QuizChoices quiz={QUIZ} compact />
          </article>
        </MacDesk>
      </div>
    </section>

    <div class="p1-modes">
      <button type="button" data-mode="note" aria-pressed="true">Ler uma nota</button>
      <button type="button" data-mode="quiz" aria-pressed="false">Responder uma questão</button>
    </div>

    <section class="p1-steps" aria-label="Como funciona">
      <article><h2>Escolher</h2><p>Temas e formato: só notas, só perguntas, ou os dois.</p></article>
      <article><h2>Ler</h2><p>Uma ideia curta no canto da tela, quando você tiver um intervalo.</p></article>
      <article><h2>Continuar</h2><p>Quando quiser outra, pede o próximo conteúdo.</p></article>
    </section>

    <div class="p1-foot">
      <button class="p1-cta" type="button" data-open-install>Instalar no Mac</button>
    </div>
  </main>

  <dialog class="p1-dlg" id="install-modal" aria-labelledby="p1-install-title">
    <button class="p1-close" type="button" data-close-install aria-label="Fechar">×</button>
    <h2 id="p1-install-title">Leve o Breve para o seu Mac</h2>
    <InstallFields fieldId="p1-cmd" />
  </dialog>

  <script>
    import { setupInstall, setupDialog } from "../../scripts/conceitos/install.js";
    import { setupStudy } from "../../scripts/conceitos/study.js";
    import { wireTryButtons } from "../../scripts/conceitos/ui.js";
    setupDialog(document.getElementById("install-modal"));
    document.querySelectorAll("[data-install-root]").forEach((el) => setupInstall(el));
    setupStudy(document.getElementById("conteudo"));
    wireTryButtons("[data-note]");
  </script>
</ConceitoBase>
