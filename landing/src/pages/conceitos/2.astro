---
import ConceitoBase from "../../layouts/ConceitoBase.astro";
import ReviewBar from "../../components/conceitos/ReviewBar.astro";
import { Image } from "astro:assets";
import mascot from "../../../../assets/bonequinho.png";
import MacDesk from "../../components/conceitos/MacDesk.astro";
import InstallFields from "../../components/conceitos/InstallFields.astro";
import QuizChoices from "../../components/conceitos/QuizChoices.astro";
import { NOTE, QUIZ } from "../../data/conceitos.js";
---

<ConceitoBase title="Seu Mac. Uma ideia a mais. · Breve" theme="#DDE7EA">
  <style is:global>
    @import "../../styles/conceitos/desk.css";
    body { margin:0; background:#DDE7EA; color:#192A32; font-family:Geist,sans-serif; font-size:16px; line-height:1.5; }
    .p2-bar { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; padding:14px 22px; }
    .p2-bar a, .p2-bar button { min-height:44px; }
    .p2-bar .github { color:#9C3A12; }
    .p2-stage { position:relative; margin:0 16px 32px; }
    .p2-stage .desk { width:100%; max-width:100%; min-height:0; border-radius: 20px; }
    .p2-overlay { position:absolute; left: 7%; top: 16%; max-width: 17rem; z-index: 2; pointer-events: none; }
    .p2-overlay h1 { font-size: clamp(28px, 4vw, 44px); margin:0 0 8px; line-height:1.1; font-weight:600; }
    .p2-stage .study-card { background:#f7fbfc; border-radius:12px; font-family:Besley,Georgia,serif; box-shadow:0 12px 32px #192A3220; }
    .p2-panel {
      position:fixed; top:0; right:0; height:100%; width:min(420px, 100%);
      background:#f4f8f9; border-left:1px solid #192A3222; padding:28px 24px; overflow:auto; z-index:6;
    }
    .p2-compare { display:grid; gap:16px; width:min(1100px, calc(100% - 40px)); margin:0 auto 24px; }
    @media (min-width: 800px) { .p2-compare { grid-template-columns: 1fr 1fr; } }
    .p2-compare article { background:#eef4f6; padding:20px; border-radius:12px; }
    .p2-corners { display:flex; gap:8px; flex-wrap:wrap; width:min(1100px, calc(100% - 40px)); margin: 0 auto 12px; }
    .p2-corners button { min-height:44px; min-width:44px; border:1px solid #192A3233; background:#fff; border-radius:8px; padding:0 12px; }
    .p2-corners button[aria-pressed="true"] { background:#192A32; color:#fff; }
    .p2-hint { width:min(1100px, calc(100% - 40px)); margin: 0 auto 28px; color:#3e5158; font-size:15px; }
    .quiz-opt { display:block; width:100%; text-align:left; margin:8px 0; padding:12px; min-height:44px; border:1px solid #192A3228; background:#fff; font:inherit; border-radius:8px; }
    .quiz-opt[aria-pressed="true"] { border-color:#E8754F; }
    .install-label { display:block; font-weight:600; margin:10px 0 6px; }
    .install-cmd { width:100%; font:14px ui-monospace,monospace; padding:10px; background:#fff; border:1px solid #192A3228; border-radius:8px; }
    .install-copy { min-height:44px; min-width:11.5rem; background:#B4451A; color:#fff; border:0; border-radius:8px; }
    .install-copy-row { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin:10px 0; }
    .install-links { display:flex; gap:16px; flex-wrap:wrap; }
    .install-links a { color:#9C3A12; min-height:44px; display:inline-flex; align-items:center; }
    .p2-close { min-height:44px; min-width:44px; border:0; background:transparent; }
    a:focus-visible, button:focus-visible, textarea:focus-visible { outline:3px solid #E8754F; outline-offset:3px; }
    @media (max-width: 900px) {
      .p2-overlay { position:static; max-width:none; padding: 12px 8px 16px; pointer-events:auto; }
      .p2-panel { position:static; width:auto; height:auto; border:0; margin: 0 16px 24px; }
    }
  </style>

  <ReviewBar n={2} />
  <header class="p2-bar">
    <a href="#conteudo" style="display:flex;gap:8px;align-items:center;text-decoration:none;color:inherit">
      <Image src={mascot} alt="" width={28} height={29} /> Breve
    </a>
    <nav style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
      <a class="github" href="https://github.com/xinnaider/breve">GitHub</a>
      <button class="p2-cta" type="button" data-open-install aria-expanded="false" aria-controls="p2-panel">Instalar no Mac</button>
    </nav>
  </header>

  <aside class="p2-panel" id="p2-panel" hidden data-install-panel aria-labelledby="p2-install-title">
    <button class="p2-close" type="button" data-close-install>Fechar</button>
    <h2 id="p2-install-title">Instalar no Mac</h2>
    <InstallFields fieldId="p2-cmd" />
  </aside>

  <main id="conteudo" data-study>
    <section class="p2-stage">
      <div class="p2-overlay">
        <h1>Seu Mac. Uma ideia a mais.</h1>
        <p>O Breve traz uma nota ou uma pergunta para você explorar durante o dia.</p>
        <button class="p2-cta" type="button" data-try style="pointer-events:auto">Experimentar uma nota</button>
        <p style="font-size:14px;color:#3e5158">Feito para o Mac. Open source.</p>
      </div>
      <MacDesk>
        <article class="study-card" data-note>
          <p style="margin:0 0 8px;font-family:Geist,sans-serif;font-size:12px">{NOTE.topic} · {NOTE.kind}</p>
          <h2 style="font-size:18px;margin:0 0 8px">{NOTE.title}</h2>
          <p style="margin:0">{NOTE.body}</p>
        </article>
      </MacDesk>
    </section>

    <p class="p2-corners" aria-label="Canto do mascote">
      <button type="button" data-corner="left" aria-pressed="false">Esquerda</button>
      <button type="button" data-corner="right" aria-pressed="true">Direita</button>
      <button type="button" data-corner="top" aria-pressed="false">Cima</button>
      <button type="button" data-corner="bottom" aria-pressed="false">Baixo</button>
    </p>
    <p class="p2-hint">Mude o canto com os botões. Arrastar não é necessário.</p>

    <section class="p2-compare">
      <article>
        <h2>Uma nota</h2>
        <p>Texto curto, no canto. Serve para reler um princípio sem abrir um curso.</p>
        <p><strong>{NOTE.title}</strong> {NOTE.body}</p>
      </article>
      <article data-quiz-inline>
        <h2>Uma questão</h2>
        <p>{QUIZ.title}</p>
        <QuizChoices quiz={QUIZ} />
      </article>
    </section>
    <section class="p2-compare">
      <article>
        <h2>Temas e idioma</h2>
        <p>Você escolhe o idioma e os temas. O mascote traz só o que você marcou.</p>
      </article>
    </section>
  </main>
  <script>
    import { setupInstall, setupPanel } from "../../scripts/conceitos/install.js";
    import { setupStudy } from "../../scripts/conceitos/study.js";
    import { wireTryButtons } from "../../scripts/conceitos/ui.js";
    setupPanel(document.getElementById("p2-panel"));
    document.querySelectorAll("[data-install-root]").forEach((el) => setupInstall(el));
    setupStudy(document.getElementById("conteudo"));
    wireTryButtons("[data-note]");
  </script>
</ConceitoBase>
