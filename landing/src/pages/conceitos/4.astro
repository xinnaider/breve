---
import ConceitoBase from "../../layouts/ConceitoBase.astro";
import ReviewBar from "../../components/conceitos/ReviewBar.astro";
import { Image } from "astro:assets";
import mascot from "../../../../assets/bonequinho.png";
import MacDesk from "../../components/conceitos/MacDesk.astro";
import InstallFields from "../../components/conceitos/InstallFields.astro";
import { NOTE } from "../../data/conceitos.js";
---

<ConceitoBase title="Aprenda entre uma tarefa e outra. · Breve" theme="#181B1B">
  <style is:global>
    @import "../../styles/conceitos/desk.css";
    body { margin:0; background:#181B1B; color:#F4F3ED; font-family:Geist,sans-serif; font-size:16px; line-height:1.5; }
    .p4-head .github { color:#F2A06B; }
    .p4-cta { min-height:44px; min-width:11.5rem; background:#F2A06B; color:#181B1B; border:0; border-radius:8px; font-weight:600; }
    .p4-hero { display:grid; gap:24px; width:min(1100px, calc(100% - 40px)); margin: 32px auto 24px; }
    .p4-hero h1 { font-size:clamp(40px, 6vw, 64px); line-height:1.05; margin:0; max-width: 16ch; }
    .p4-band { width:min(820px, calc(100% - 40px)); margin: 0 auto; padding: 0 0 16px; }
    .p4-band .desk { border-radius:16px; }
    .p4-band .desk-wall { object-position: 86% 40%; }
    .p4-band .desk-folder { display:none; }
    @media (min-width: 769px) { .p4-band .desk { aspect-ratio: 4 / 3; } }
    .p4-cap { width:min(1100px, calc(100% - 40px)); margin: 8px auto 32px; color:#c9c6bc; font-size:14px; }
    .p4-ch { width:min(800px, calc(100% - 40px)); margin: 0 auto 48px; }
    .p4-ch h2 { font-size:28px; }
    .p4-ch:nth-of-type(even) { margin-left: auto; text-align: right; }
    @media (max-width: 700px) { .p4-ch:nth-of-type(even) { text-align: left; } }
    dialog.p4-dlg { border:0; background:#202424; color:#F4F3ED; width:min(720px, calc(100% - 16px)); max-width:100%; max-height:calc(100dvh - 16px); border-radius:12px; padding:0; overflow-x:hidden; overflow-y:auto; }
    dialog.p4-dlg::backdrop { background:#0008; }
    .p4-grid { display:grid; grid-template-columns: 1fr; min-width:0; }
    @media (min-width: 720px) { .p4-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
    .p4-grid > div { padding:24px; min-width:0; }
    .p4-cmdwrap { min-width:0; overflow-x:auto; }
    .p4-dlg .install-cmd {
      display:block; width:100%; min-width:0; max-width:100%;
      white-space: nowrap; overflow-x: auto;
      font:14px ui-monospace,monospace; background:#111414; color:#F4F3ED;
      border:1px solid #ffffff22; padding:12px; resize:none;
    }
    .install-label { display:block; font-weight:600; margin:10px 0 6px; }
    .install-copy { min-height:44px; min-width:11.5rem; background:#F2A06B; color:#181B1B; border:0; }
    .install-copy-row { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin:10px 0; }
    .install-links { display:flex; gap:16px; flex-wrap:wrap; }
    .install-links a { color:#F2A06B; min-height:44px; display:inline-flex; align-items:center; }
    .p4-close { min-height:44px; min-width:44px; background:transparent; color:#F4F3ED; border:0; }
    a:focus-visible, button:focus-visible, textarea:focus-visible { outline:3px solid #F2A06B; outline-offset:3px; }
    .p4-desk .study-card { background:#2a2e2e; font-family:Besley,Georgia,serif; width:min(560px, 74%); }
    .p4-desk .study-card h2 { font-size:22px; }
    @media (max-width: 768px) { .p4-desk .study-card { width:100%; } }
  </style>

  <ReviewBar n={4} />
  <header class="p4-head">
    <a href="#conteudo" style="display:flex;gap:8px;align-items:center;text-decoration:none;color:inherit">
      <Image src={mascot} alt="" width={26} height={27} /> Breve
    </a>
    <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
      <a class="github" href="https://github.com/xinnaider/breve">GitHub</a>
      <button class="p4-cta" type="button" data-open-install>Instalar no Mac</button>
    </div>
  </header>
  <main id="conteudo">
    <section class="p4-hero">
      <div>
        <h1>Aprenda entre uma tarefa e outra.</h1>
        <p>Notas e perguntas curtas, nos temas que você escolher.</p>
        <button class="p4-cta" type="button" data-open-install>Instalar no Mac</button>
        <button type="button" data-try style="min-height:44px;margin-left:8px;background:transparent;color:#F4F3ED;border:1px solid #ffffff33;border-radius:8px;padding:0 14px">Experimentar uma nota</button>
        <p style="color:#9a9890">Feito para o Mac. Open source.</p>
      </div>
    </section>
    <section class="p4-band p4-desk" data-study>
      <MacDesk>
        <article class="study-card" data-note>
          <p style="margin:0 0 6px;font-family:Geist,sans-serif;font-size:12px;color:#c9c6bc">{NOTE.kind}</p>
          <h2 style="font-size:22px;margin:0 0 8px">{NOTE.title}</h2>
          <p style="margin:0">{NOTE.body}</p>
        </article>
      </MacDesk>
      <p class="p4-cap">A nota abre ao lado do mascote, na borda. Não há ícone do Breve no Dock.</p>
    </section>
    <section class="p4-ch"><h2>Conteúdo</h2><p>Cada carta traz uma ideia pronta para reler: um princípio, um contraste, uma pergunta.</p></section>
    <section class="p4-ch"><h2>Formato</h2><p>Notas, questões ou os dois. Você marca isso uma vez na configuração.</p></section>
    <section class="p4-ch"><h2>Presença discreta</h2><p>O mascote fica na borda. Sem ícone permanente no Dock.</p></section>
  </main>
  <dialog class="p4-dlg" id="p4-dlg" aria-labelledby="p4-t">
    <div class="p4-grid">
      <div>
        <button class="p4-close" type="button" data-close-install aria-label="Fechar">×</button>
        <h2 id="p4-t">Instalar no Mac</h2>
        <p>Destino: Aplicativos. Compilação neste computador.</p>
        <p>Para Mac com Apple Silicon e macOS 14 ou mais recente. Requer Xcode e XcodeGen.</p>
        <p>O instalador compila o Breve no seu Mac e coloca o app em Aplicativos.</p>
      </div>
      <div>
        <div class="p4-cmdwrap">
          <InstallFields fieldId="p4-cmd" hideReq hideBlurb />
        </div>
      </div>
    </div>
  </dialog>
  <script>
    import { setupInstall, setupDialog } from "../../scripts/conceitos/install.js";
    import { setupStudy } from "../../scripts/conceitos/study.js";
    import { wireTryButtons } from "../../scripts/conceitos/ui.js";
    setupDialog(document.getElementById("p4-dlg"));
    document.querySelectorAll("[data-install-root]").forEach((el) => setupInstall(el));
    setupStudy(document.querySelector("[data-study]"));
    wireTryButtons("[data-note]");
  </script>
</ConceitoBase>
