---
import ReviewBar from "../../components/conceitos/ReviewBar.astro";
import ConceitoBase from "../../layouts/ConceitoBase.astro";
import InstallFields from "../../components/conceitos/InstallFields.astro";
import MacDesk from "../../components/conceitos/MacDesk.astro";
import { NOTE } from "../../data/conceitos.js";
---

<ConceitoBase title="Cabe no seu intervalo. · Breve" theme="#FFF8EB">
  <style is:global>
    @import "../../styles/conceitos/desk.css";
    body { margin:0; background:#FFF8EB; color:#24211E; font-family:Besley,Georgia,serif; font-size:16px; line-height:1.5; }
    .p5-top .github { color:#8E3218; }
    .p5-hero { display:grid; gap:20px; width:min(1180px, calc(100% - 32px)); margin: 28px auto; align-items:start; }
    @media (min-width: 960px) { .p5-hero { grid-template-columns: 6fr 4fr 2fr; } }
    .p5-hero h1 { font-family:Geist,sans-serif; font-size:clamp(48px, 8vw, 92px); line-height:0.95; letter-spacing:-.04em; margin:0; }
    .p5-card { background:#fff; border:1px solid #24211E22; padding:16px; transform: rotate(-1.2deg); }
    .p5-col { display:flex; flex-direction:column; gap:12px; font-family:Geist,sans-serif; }
    .p5-cta { min-height:44px; background:#A84830; color:#fff; border:0; display:inline-flex; gap:8px; align-items:center; justify-content:center; padding:0 14px; font-family:Geist,sans-serif; }
    .p5-flow { display:grid; gap:0; width:min(1100px, calc(100% - 32px)); margin: 40px auto; border-top:1px solid #24211E; }
    @media (min-width: 800px) { .p5-flow { grid-template-columns: 1fr 1fr 1fr; } }
    .p5-flow div { padding:20px; border-bottom:1px solid #24211E22; }
    @media (min-width: 800px) {
      .p5-flow div { border-right:1px solid #24211E22; border-bottom:0; }
      .p5-flow div:last-child { border-right:0; }
    }
    .p5-end { text-align:center; padding: 48px 16px 24px; font-family:Geist,sans-serif; font-size:28px; }
    dialog.p5-dlg { width:min(480px, calc(100% - 16px)); max-height:calc(100dvh - 16px); overflow:auto; border:1px solid #24211E; background:#FFF8EB; padding:24px; }
    dialog.p5-dlg::backdrop { background:#24211E33; }
    .install-label { display:block; font-family:Geist,sans-serif; font-weight:600; margin:10px 0 6px; }
    .install-cmd, .install-script-url { width:100%; font:13px ui-monospace,monospace; padding:10px; overflow-x:auto; }
    .install-copy { min-height:44px; min-width:11.5rem; background:#A84830; color:#fff; border:0; }
    .install-copy-row { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin:10px 0; }
    .install-links { display:flex; gap:16px; flex-wrap:wrap; font-family:Geist,sans-serif; }
    .install-links a { color:#8E3218; min-height:44px; display:inline-flex; align-items:center; }
    a:focus-visible, button:focus-visible, textarea:focus-visible, input:focus-visible { outline:3px solid #C95C3F; outline-offset:3px; }
    @media (max-width: 700px) { .p5-card { transform:none; } }
  </style>

  <ReviewBar n={5} />
  <header class="p5-top">
    <a href="#conteudo" style="text-decoration:none;color:inherit;min-height:44px;display:inline-flex;align-items:center">Breve</a>
    <nav style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
      <a class="github" href="https://github.com/xinnaider/breve">GitHub</a>
      <button class="p5-cta" type="button" data-open-install>
        <svg width="14" height="16" viewBox="0 0 14 16" aria-hidden="true"><path fill="currentColor" d="M11.2 8.2c0-2.1 1.7-3 1.8-3.1-1-1.5-2.6-1.7-3.1-1.7-1.3-.1-2.5.8-3.2.8s-1.7-.8-2.8-.7c-1.4.1-2.8.9-3.5 2.2-1.5 2.6-.4 6.5 1.1 8.6.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.6.7 2.8.7 1.9-1.1 2.6-2.1c.8-1.1 1.1-2.2 1.1-2.2s-2.2-.8-2.3-3.6ZM9.3 3.3c.6-.7 1-1.7.9-2.7-1 .05-2.1.7-2.7 1.5-.6.7-1.1 1.8-.9 2.7 1.1.1 2.1-.5 2.7-1.5Z"/></svg>
        Instalar no Mac
      </button>
    </nav>
  </header>
  <main id="conteudo">
    <section class="p5-hero">
      <div>
        <h1>Cabe no seu intervalo.</h1>
        <p>Uma nota para ler. Uma pergunta para pensar. O Breve fica no canto do seu Mac.</p>
      </div>
      <article class="p5-card">
        <p style="font-family:Geist,sans-serif;font-size:12px;margin:0 0 8px">{NOTE.kind} · {NOTE.topic}</p>
        <h2 style="font-size:20px;margin:0 0 8px">{NOTE.title}</h2>
        <p style="margin:0">{NOTE.body}</p>
      </article>
      <div class="p5-col">
        <button class="p5-cta" type="button" data-open-install>Instalar no Mac</button>
        <button type="button" data-try style="min-height:44px;border:1px solid #24211E;background:transparent">Experimentar uma nota</button>
        <p style="font-size:13px;color:#5c564f">Feito para o Mac. Open source.</p>
      </div>
    </section>
    <section class="p5-flow" aria-label="Como usar">
      <div><h2>Escolha</h2><p>Temas e formato, uma vez.</p></div>
      <div><h2>Experimente</h2><p>Uma nota ou uma questão no canto.</p></div>
      <div><h2>Continue</h2><p>Peça o próximo quando quiser.</p></div>
    </section>
    <div data-study style="width:min(900px, calc(100% - 32px));margin:0 auto 24px">
      <MacDesk compact>
        <article class="study-card" data-note style="background:#fff;padding:12px">
          <h2 style="font-size:16px;margin:0 0 6px">{NOTE.title}</h2>
          <p style="margin:0">{NOTE.body}</p>
        </article>
      </MacDesk>
    </div>
    <p class="p5-end">Feito para o Mac. Open source.</p>
  </main>
  <dialog class="p5-dlg" id="p5-dlg" aria-labelledby="p5-t">
    <button type="button" data-close-install aria-label="Fechar" style="min-height:44px">×</button>
    <h2 id="p5-t">Instalar no Mac</h2>
    <InstallFields fieldId="p5-cmd" showScriptField />
  </dialog>
  <script>
    import { setupInstall, setupDialog } from "../../scripts/conceitos/install.js";
    import { setupStudy } from "../../scripts/conceitos/study.js";
    import { wireTryButtons } from "../../scripts/conceitos/ui.js";
    setupDialog(document.getElementById("p5-dlg"));
    document.querySelectorAll("[data-install-root]").forEach((el) => setupInstall(el));
    setupStudy(document.querySelector("[data-study]"));
    wireTryButtons("[data-note]");
  </script>
</ConceitoBase>
